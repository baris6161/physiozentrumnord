# SMTP-Zugang des Kundenpostfachs (in Vercel als Environment Variables hinterlegen)
# Beispiel fuer die meisten Hoster (IONOS, All-Inkl, Strato, Google Workspace ...)
SMTP_HOST=smtp.ihr-hoster.de
SMTP_PORT=465
SMTP_SECURE=true            # true bei Port 465 (SSL), false bei Port 587 (STARTTLS)
SMTP_USER=info@krankengymnastik-in-hannover.de
SMTP_PASS=dein-mail-passwort

# Empfaenger + Absender der Formular-Mails
CONTACT_TO=info@krankengymnastik-in-hannover.de
CONTACT_FROM=info@krankengymnastik-in-hannover.de

# Oeffentliche Basis-URL (fuer canonical / Sitemap / OG)
NEXT_PUBLIC_SITE_URL=https://www.krankengymnastik-in-hannover.de
